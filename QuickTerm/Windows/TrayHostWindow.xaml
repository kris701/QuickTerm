<Window
    x:Class="QuickTerm.Windows.TrayHostWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:QuickTerm.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:QuickTerm.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:QuickTerm.Models"
    xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title=""
    Width="0"
    Height="0"
    d:DataContext="{d:DesignInstance local:TrayHostWindow,
                                     IsDesignTimeCreatable=True}"
    Loaded="Window_Loaded"
    ShowInTaskbar="False"
    Visibility="Hidden"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <converters:ListNotEmptyConverter
            x:Key="CountToVis"
            False="Collapsed"
            True="Visible" />
    </Window.Resources>

    <Grid>
        <tray:NotifyIcon
            x:Name="trayIcon"
            FocusOnLeftClick="True"
            Icon="pack://application:,,,/Assets/icon2.png"
            MenuOnRightClick="True"
            TooltipText="QuickTerm">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem
                        Header="Commands"
                        ItemsSource="{Binding Config.Nodes}"
                        Visibility="{Binding Config.Nodes, Converter={StaticResource CountToVis}}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <Setter Property="ItemsSource" Value="{Binding Nodes}" />
                                <Setter Property="Tag" Value="{Binding Command}" />
                                <EventSetter Event="Click" Handler="ExecuteCommand_Click" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Click="SettingsButton_Click" Header="Settings" />
                    <MenuItem Click="ExitButton_Click" Header="Exit" />
                    <MenuItem Click="UpdateButton_Click" Header="Update Available!" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</Window>
