<Window
    x:Class="QuickTerm.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:QuickTerm.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:usercon="clr-namespace:QuickTerm.UserControls"
    Title="QuickTerm Settings"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance local:SettingsWindow,
                                     IsDesignTimeCreatable=True}"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Icon="/Assets/icon1.png"
    ResizeMode="NoResize"
    Topmost="True"
    mc:Ignorable="d">
    <StackPanel Margin="5">

        <ItemsControl ItemsSource="{Binding Config.Nodes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="45" />
                        </Grid.ColumnDefinitions>

                        <usercon:TerminalNodeControl Data="{Binding}" />
                        <ui:Button
                            x:Name="RemoveNodeButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Appearance="Danger"
                            Click="RemoveNodeButton_Click"
                            Icon="{ui:SymbolIcon Delete16}"
                            Tag="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:Button
            x:Name="AddRootNode"
            HorizontalAlignment="Stretch"
            Appearance="Info"
            Click="AddRootNode_Click"
            Content="Add"
            Icon="{ui:SymbolIcon Add16}" />

        <ui:Button
            x:Name="SaveSettingsButton"
            HorizontalAlignment="Stretch"
            Appearance="Success"
            Click="SaveSettingsButton_Click"
            Content="Save"
            Icon="{ui:SymbolIcon Save16}" />
    </StackPanel>
</Window>
