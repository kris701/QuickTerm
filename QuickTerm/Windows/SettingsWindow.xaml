<Window
    x:Class="QuickTerm.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:QuickTerm.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:QuickTerm.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:QuickTerm.Models"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="QuickTerm Settings"
    Width="800"
    Height="450"
    MinWidth="400"
    MinHeight="400"
    d:DataContext="{d:DesignInstance local:SettingsWindow,
                                     IsDesignTimeCreatable=True}"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Closing="Window_Closing"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Icon="/Assets/icon1.png"
    Topmost="True"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:NullToVisibilityConverter
            x:Key="NullToVis"
            False="Visible"
            True="Collapsed" />
        <converters:NullToVisibilityConverter
            x:Key="NullToVisInv"
            False="Hidden"
            True="Visible" />
        <converters:ListNotEmptyConverter
            x:Key="CountToVis"
            False="Hidden"
            True="Visible" />
        <converters:ListNotEmptyConverter
            x:Key="CountToVisInv"
            False="Visible"
            True="Hidden" />

        <ObjectDataProvider
            x:Key="terminalOptions"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TerminalTypes" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <DataTemplate DataType="{x:Type models:TerminalNode}">
            <Border
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="5">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="45" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <ui:TextBox
                        Grid.ColumnSpan="2"
                        Margin="3"
                        Text="{Binding Name}" />

                    <Grid Grid.Row="1" Visibility="{Binding Command, Converter={StaticResource NullToVisInv}}">
                        <Grid Visibility="{Binding Nodes, Converter={StaticResource CountToVisInv}}">
                            <ui:Button
                                Margin="3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Appearance="Primary"
                                Click="AddNode_Click"
                                Content="Add Node"
                                Icon="{ui:SymbolIcon Add16}"
                                Tag="{Binding}" />
                        </Grid>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Grid.Column="1"
                        Visibility="{Binding Command, Converter={StaticResource NullToVisInv}}">
                        <Grid Visibility="{Binding Nodes, Converter={StaticResource CountToVisInv}}">
                            <ui:Button
                                Margin="3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Appearance="Primary"
                                Click="AddCommandButton_Click"
                                Content="Set Command"
                                Icon="{ui:SymbolIcon Add16}"
                                Tag="{Binding}" />
                        </Grid>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Visibility="{Binding Command, Converter={StaticResource NullToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="45" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Content="{Binding Command}" />

                        <ui:Button
                            Grid.Column="1"
                            Margin="3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Appearance="Danger"
                            Click="RemoveCommandButton_Click"
                            Icon="{ui:SymbolIcon Delete16}"
                            Tag="{Binding}" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Visibility="{Binding Nodes, Converter={StaticResource CountToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <ItemsControl ItemsSource="{Binding Nodes}" />
                        <ui:Button
                            Grid.Row="1"
                            Margin="3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Appearance="Info"
                            Click="AddNode_Click"
                            Content="Add Node"
                            Icon="{ui:SymbolIcon Add16}"
                            Tag="{Binding}" />
                    </Grid>

                    <ui:Button
                        Grid.RowSpan="2"
                        Grid.Column="2"
                        Margin="3"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Appearance="Danger"
                        Click="RemoveNodeButton_Click"
                        Icon="{ui:SymbolIcon Delete16}"
                        Tag="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:TerminalCommand}">
            <Border
                Margin="2"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="5">
                <ui:CardExpander Header="Command">
                    <StackPanel Margin="5">
                        <ui:TextBox
                            Height="100"
                            Margin="3"
                            Text="{Binding Command}"
                            TextWrapping="Wrap" />
                        <Label>Working Directory</Label>
                        <ui:TextBox Margin="3" Text="{Binding WorkingDirectory}" />
                        <Label>Terminal Type</Label>
                        <ComboBox ItemsSource="{Binding Source={StaticResource terminalOptions}}" SelectedItem="{Binding TerminalType}" />
                        <Label>Show Terminal</Label>
                        <ui:ToggleSwitch
                            IsChecked="{Binding ShowTerminal}"
                            OffContent="No"
                            OnContent="Yes" />
                        <Label>Pause on Completion</Label>
                        <ui:ToggleSwitch
                            IsChecked="{Binding PauseOnCompletion}"
                            OffContent="No"
                            OnContent="Yes" />
                    </StackPanel>
                </ui:CardExpander>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel>
                <ui:CardExpander Header="General">
                    <StackPanel>
                        <Label>Run on startup</Label>
                        <ui:ToggleSwitch
                            IsChecked="{Binding Config.RunOnStartup}"
                            OffContent="No"
                            OnContent="Yes" />
                        <Label>Check for Updates</Label>
                        <ui:ToggleSwitch
                            IsChecked="{Binding Config.CheckForUpdates}"
                            OffContent="No"
                            OnContent="Yes" />
                    </StackPanel>
                </ui:CardExpander>
                <ui:CardExpander Header="Node Tree">
                    <StackPanel>
                        <ui:Button
                            x:Name="AddRootNode"
                            Margin="2"
                            HorizontalAlignment="Stretch"
                            Appearance="Info"
                            Click="AddRootNode_Click"
                            Content="Add"
                            Icon="{ui:SymbolIcon Add16}" />

                        <Grid Visibility="{Binding Config.Nodes, Converter={StaticResource CountToVisInv}}">
                            <Label
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontStyle="Italic">
                                No nodes added yet...
                            </Label>
                        </Grid>

                        <ItemsControl Margin="2" ItemsSource="{Binding Config.Nodes}" />
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <ui:Button
                x:Name="SaveSettingsButton"
                Margin="2"
                HorizontalAlignment="Stretch"
                Appearance="Success"
                Click="SaveSettingsButton_Click"
                Content="Save"
                Icon="{ui:SymbolIcon Save16}" />
            <ui:Button
                x:Name="CancelSettingsButton"
                Grid.Column="1"
                Margin="2"
                HorizontalAlignment="Stretch"
                Appearance="Caution"
                Click="CancelSettingsButton_Click"
                Content="Cancel"
                Icon="{ui:SymbolIcon ArrowStepBack16}" />
        </Grid>
    </Grid>

</Window>
